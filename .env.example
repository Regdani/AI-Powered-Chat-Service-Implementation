# LLM backend: mock (default, no API key) | azure | gemini
# Real providers fail fast when required variables are missing; there is no
# silent fallback to mock.
LLM_PROVIDER=mock

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Google Gemini (LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Weather MCP (no API key). Configured at startup; connected on first tool call.
MCP_WEATHER_URL=https://weather.chukai.io/mcp
MCP_WEATHER_TRANSPORT=streamable_http

# HTTP server
APP_HOST=0.0.0.0
APP_PORT=18080
