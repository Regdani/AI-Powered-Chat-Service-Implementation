# LLM backend: mock (default, no API key) | openai | azure | gemini
# Real providers fail fast when required variables are missing; there is no
# silent fallback to mock.
LLM_PROVIDER=mock

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Google Gemini (LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Weather MCP (no API key)
MCP_WEATHER_URL=https://weather.chukai.io/mcp

# HTTP server
APP_HOST=0.0.0.0
APP_PORT=18080
